            "markdownDescription": "Deprecated: migrated to `gams.studio.arguments` on activation (kept only for migration)."
          },
          "GAMS.listingFileLocation": {
            "type": "string",
            "deprecationMessage": "Setting of GAMS 0.1.x, still supported but deprecated: use projects, the gams.editor.* settings or GAMS tasks instead.",
            "markdownDescription": "Deprecated, still supported: fallback for `gams.editor.openLocation` (`Beside`, `Active`, `One`..`Nine`)."
          }
