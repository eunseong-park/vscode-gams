  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "lint": "tsc --noEmit -p .",
    "compile-tests": "tsc -p . --noEmit false --outDir out",
    "test": "npm run compile-tests && mocha \"out/test/unit/**/*.test.js\"",
    "test:integration": "npm run compile-tests && node out/test/runTest.js",
    "test:integration:headless": "xvfb-run -a npm run test:integration",
    "check:docs-overlap": "node scripts/check-doc-overlap.js",
    "check:fixture-origin": "node scripts/check-fixture-origin.js",
    "gen:notices": "node scripts/gen-notices.js",
    "package": "node esbuild.js --production && vsce package",
    "build:server": "node scripts/build-server.js",
    "package:linux": "node scripts/package.js linux-x64",
    "build:server:win32": "node scripts/build-server.js x86_64-pc-windows-gnu",
    "package:win32": "node scripts/package.js win32-x64",
    "package:linux-arm64": "node scripts/package.js linux-arm64",
    "package:darwin-arm64": "node scripts/package.js darwin-arm64",
    "package:darwin-x64": "node scripts/package.js darwin-x64",
    "vscode:prepublish": "node esbuild.js --production"
  },
