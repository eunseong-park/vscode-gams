    "breakpoints": [
      {
        "language": "gams"
      },
      {
        "language": "gams-inc"
      }
    ],
    "debuggers": [
      {
        "type": "gams",
        "label": "GAMS",
        "languages": [
          "gams",
          "gams-inc"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "GAMS model to run (.gms).",
                "default": "${file}"
              },
              "parameters": {
                "type": [
                  "array",
                  "string"
                ],
                "items": {
                  "type": "string"
                },
                "description": "Additional GAMS command line parameters (appended after DebugPort and gams.defaultParameters).",
                "default": []
              },
              "cwd": {
                "type": "string",
                "description": "Working directory (default: the directory of program)."
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Stop at the first executable line (GAMS Studio: Step Debugger).",
                "default": false
              },
              "maxRecords": {
                "type": "number",
                "description": "Records shown per symbol in the Variables view.",
                "default": 100
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "gams",
            "request": "launch",
            "name": "GAMS: Debug current file",
            "program": "${file}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "GAMS: Debug",
            "description": "Debug a GAMS model",
            "body": {
              "type": "gams",
              "request": "launch",
              "name": "GAMS: Debug",
              "program": "^\"\\${file}\"",
              "parameters": []
            }
          },
          {
            "label": "GAMS: Step Debug",
            "description": "Debug a GAMS model, stopping at the first line",
            "body": {
              "type": "gams",
              "request": "launch",
              "name": "GAMS: Step Debug",
              "program": "^\"\\${file}\"",
              "stopOnEntry": true
            }
          }
        ]
      }
    ],
    "configurationDefaults": {
      "[gams]": {
        "editor.matchBrackets": "never",
        "editor.bracketPairColorization.enabled": false
      },
      "[gams-inc]": {
        "editor.matchBrackets": "never",
        "editor.bracketPairColorization.enabled": false
      }
    },
    "taskDefinitions": [
      {
        "type": "gams",
        "required": [],
        "properties": {
          "file": {
            "type": "string",
            "description": "GAMS file to run. Default: ${file} (the active GAMS file; the project's main file applies as for F9).",
            "default": "${file}"
          },
          "parameters": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Additional GAMS parameters (key=value), applied after gams.defaultParameters."
          },
          "compile": {
            "type": "boolean",
            "default": false,
            "description": "Compile only (action=c) instead of running."
          }
        }
      }
    ]
