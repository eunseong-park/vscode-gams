{
  "name": "vscode-gams",
  "displayName": "GAMS",
  "description": "GAMS language support, run/compile, GDX viewer, debugger and more: a port of GAMS Studio features to VS Code (unofficial).",
  "version": "0.3.1",
  "publisher": "eunseong-park",
  "license": "GPL-3.0-or-later",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Data Science",
    "Visualization"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:gams",
    "onLanguage:gams-inc",
    "onLanguage:gams-opt",
    "onLanguage:gams-lst",
    "onTaskType:gams",
    "workspaceContains:**/*.connect.{yaml,yml}"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "gams.gdxViewer",
        "displayName": "GDX Viewer",
        "priority": "default",
        "selector": [
          {
            "filenamePattern": "*.gdx"
          }
        ]
      }
    ],
    "languages": [
      {
        "id": "gams",
        "aliases": [
          "GAMS",
          "gams"
        ],
        "extensions": [
          ".gms",
          ".dmp"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/icons/gms.svg",
          "dark": "./images/icons/gms.svg"
        }
      },
      {
        "id": "gams-inc",
        "aliases": [
          "GAMS Include",
          "gams-inc"
        ],
        "extensions": [
          ".inc"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/icons/inc.svg",
          "dark": "./images/icons/inc.svg"
        }
      },
      {
        "id": "gams-opt",
        "aliases": [
          "GAMS Option File",
          "gams-opt"
        ],
        "configuration": "./language-configuration-opt.json",
        "extensions": [
          ".opt",
          ".op2",
          ".op3",
          ".op4",
          ".op5",
          ".op6",
          ".op7",
          ".op8",
          ".op9",
          ".pf"
        ],
        "filenamePatterns": [
          "*.o[1-9][0-9]",
          "*.[1-9][0-9][0-9]",
          "*.[1-9][0-9][0-9][0-9]"
        ],
        "icon": {
          "light": "./images/icons/opt.svg",
          "dark": "./images/icons/opt.svg"
        }
      },
      {
        "id": "gams-lst",
        "aliases": [
          "GAMS Listing",
          "gams-lst"
        ],
        "extensions": [
          ".lst"
        ],
        "icon": {
          "light": "./images/icons/lst.svg",
          "dark": "./images/icons/lst.svg"
        }
      },
      {
        "id": "gams-gdx",
        "aliases": [
          "GAMS Data (GDX)",
          "gams-gdx"
        ],
        "extensions": [
          ".gdx"
        ],
        "icon": {
          "light": "./images/icons/gdx.svg",
          "dark": "./images/icons/gdx.svg"
        }
      },
      {
        "id": "gams-ref",
        "aliases": [
          "GAMS Reference",
          "gams-ref"
        ],
        "extensions": [
          ".ref"
        ],
        "icon": {
          "light": "./images/icons/ref.svg",
          "dark": "./images/icons/ref.svg"
        }
      },
      {
        "id": "gams-lxi",
        "aliases": [
          "GAMS Listing Index",
          "gams-lxi"
        ],
        "extensions": [
          ".lxi"
        ],
        "icon": {
          "light": "./images/icons/lxi.svg",
          "dark": "./images/icons/lxi.svg"
        }
      },
      {
        "id": "gams-gsp",
        "aliases": [
          "GAMS Project",
          "gams-gsp"
        ],
        "extensions": [
          ".gsp"
        ],
        "icon": {
          "light": "./images/icons/gsp.svg",
          "dark": "./images/icons/gsp.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "gams",
        "scopeName": "source.gams",
        "path": "./syntaxes/gams.tmLanguage.json"
      },
      {
        "language": "gams-inc",
        "scopeName": "source.gams",
        "path": "./syntaxes/gams.tmLanguage.json"
      }
    ],
    "yamlValidation": [
      {
        "fileMatch": "*.connect.yaml",
        "url": "./schemas/connect/connect.schema.json"
      },
      {
        "fileMatch": "*.connect.yml",
        "url": "./schemas/connect/connect.schema.json"
      }
    ],
    "snippets": [
      {
        "language": "yaml",
        "path": "./snippets/connect.json"
      }
    ],
    "commands": [
      {
        "command": "gams.runConnect",
        "title": "Run Connect File",
        "category": "GAMS",
        "icon": "$(play)"
      },
      {
        "command": "gams.treatAsConnect",
        "title": "Treat as Connect File",
        "category": "GAMS"
      },
      {
        "command": "gams.setMainFile",
        "title": "Set as Main File",
        "category": "GAMS"
      },
      {
        "command": "gams.gdxDiff",
        "title": "GDX Diff...",
        "category": "GAMS"
      },
      {
        "command": "gams.gdxCompare",
        "title": "Compare with…",
        "category": "GAMS",
        "icon": "$(diff)"
      },
      {
        "command": "gams.gdxOpenDiffView",
        "title": "Open gdxdiff Result as Colored Diff",
        "category": "GAMS"
      },
      {
        "command": "gams.openGdxSymbol",
        "title": "Open GDX Symbol",
        "category": "GAMS"
      },
      {
        "command": "gams.gdxSearch.symbol",
        "title": "Find Symbol in GDX Files",
        "category": "GAMS",
        "icon": "$(search)"
      },
      {
        "command": "gams.gdxSearch.element",
        "title": "Find Element in GDX Files",
        "category": "GAMS",
        "icon": "$(symbol-key)"
      },
      {
        "command": "gams.gdxFiles.refresh",
        "title": "Refresh GDX Files",
        "category": "GAMS",
        "icon": "$(refresh)"
      },
      {
        "command": "gams.gdxFiles.open",
        "title": "Open",
        "category": "GAMS"
      },
      {
        "command": "gams.gdxFiles.compare",
        "title": "Compare with...",
        "category": "GAMS"
      },
      {
        "command": "gams.selectInstallation",
        "title": "GAMS: Select GAMS Installation"
      },
      {
        "command": "gams.openModelLibrary",
        "title": "GAMS: Open Model Library"
      },
      {
        "command": "gams.run",
        "title": "Run",
        "category": "GAMS",
        "icon": "$(play)"
      },
      {
        "command": "gams.runNeos",
        "title": "Run on NEOS",
        "category": "GAMS"
      },
      {
        "command": "gams.neosResetConsent",
        "title": "Reset NEOS Terms Confirmation",
        "category": "GAMS"
      },
      {
        "command": "gams.compile",
        "title": "Compile",
        "category": "GAMS",
        "icon": "$(debug-start)"
      },
      {
        "command": "gams.runWithOptions",
        "title": "Run with Parameters...",
        "category": "GAMS",
        "icon": "$(play-circle)"
      },
      {
        "command": "gams.compileWithOptions",
        "title": "Compile with Parameters...",
        "category": "GAMS"
      },
      {
        "command": "gams.interrupt",
        "title": "Interrupt",
        "category": "GAMS",
        "icon": "$(debug-pause)"
      },
      {
        "command": "gams.stop",
        "title": "Stop",
        "category": "GAMS",
        "icon": "$(debug-stop)"
      },
      {
        "command": "gams.showLog",
        "title": "Show Log",
        "category": "GAMS"
      },
      {
        "command": "gams.symbols.refresh",
        "title": "Refresh Symbols",
        "category": "GAMS",
        "icon": "$(refresh)"
      },
      {
        "command": "gams.symbols.filter",
        "title": "Filter Symbols...",
        "category": "GAMS",
        "icon": "$(filter)"
      },
      {
        "command": "gams.symbols.clearFilter",
        "title": "Clear Symbol Filter",
        "category": "GAMS",
        "icon": "$(clear-all)"
      },
      {
        "command": "gams.debug",
        "title": "Run Debugger",
        "category": "GAMS",
        "icon": "$(debug-alt)"
      },
      {
        "command": "gams.stepDebug",
        "title": "Step Debugger",
        "category": "GAMS",
        "icon": "$(debug-step-into)"
      },
      {
        "command": "gams.debug.openSnapshot",
        "title": "Open Snapshot in GDX Viewer",
        "category": "GAMS",
        "icon": "$(table)"
      },
      {
        "command": "gams.profile",
        "title": "Run with Profiler",
        "category": "GAMS",
        "icon": "$(dashboard)"
      },
      {
        "command": "gams.profile.summary",
        "title": "Show Profile Summary",
        "category": "GAMS"
      },
      {
        "command": "gams.profile.clear",
        "title": "Clear Profile",
        "category": "GAMS"
      },
      {
        "command": "gams.contextHelp",
        "title": "Help for Word at Cursor",
        "category": "GAMS"
      },
      {
        "command": "gams.toggleLineComment",
        "title": "Toggle Line Comment (column 1)",
        "category": "GAMS"
      },
      {
        "command": "gams.addLineComment",
        "title": "Add Line Comment (column 1)",
        "category": "GAMS"
      },
      {
        "command": "gams.removeLineComment",
        "title": "Remove Line Comment (column 1)",
        "category": "GAMS"
      },
      {
        "command": "gams.toggleBlockComment",
        "title": "Toggle Block Comment ($onText/$offText)",
        "category": "GAMS"
      },
      {
        "command": "gams.insertNewSection",
        "title": "Insert New Section",
        "category": "GAMS"
      },
      {
        "command": "gams.openInStudio",
        "title": "Open in GAMS Studio",
        "category": "GAMS"
      },
      {
        "command": "gams.jumpToMatchingParenthesis",
        "title": "Jump to Matching Parenthesis",
        "category": "GAMS"
      },
      {
        "command": "gams.showListing",
        "title": "Show Listing File",
        "category": "GAMS"
      },
      {
        "command": "gams.openCorrGDX",
        "title": "Open Corresponding GDX File",
        "category": "GAMS"
      },
      {
        "command": "gams.toggleRunProject",
        "title": "Toggle Run Project (deprecated)",
        "category": "GAMS"
      }
    ],
    "keybindings": [
      {
        "command": "gams.run",
        "key": "f9",
        "when": "editorLangId =~ /^gams(-inc)?$/ && !inDebugMode"
      },
      {
        "command": "gams.compile",
        "key": "shift+f9",
        "when": "editorLangId =~ /^gams(-inc)?$/ && !inDebugMode"
      },
      {
        "command": "gams.runWithOptions",
        "key": "f10",
        "when": "editorLangId =~ /^gams(-inc)?$/ && !inDebugMode"
      },
      {
        "command": "gams.compileWithOptions",
        "key": "shift+f10",
        "when": "editorLangId =~ /^gams(-inc)?$/ && !inDebugMode"
      },
      {
        "command": "gams.contextHelp",
        "key": "f1",
        "when": "editorTextFocus && editorLangId =~ /^gams(-inc|-opt|-lst)?$/ && config.gams.help.f1"
      },
      {
        "command": "gams.toggleLineComment",
        "key": "ctrl+/",
        "mac": "cmd+/",
        "when": "editorTextFocus && !editorReadonly && editorLangId =~ /^gams(-inc)?$/"
      },
      {
        "command": "gams.addLineComment",
        "key": "ctrl+k ctrl+c",
        "mac": "cmd+k cmd+c",
        "when": "editorTextFocus && !editorReadonly && editorLangId =~ /^gams(-inc)?$/"
      },
      {
        "command": "gams.removeLineComment",
        "key": "ctrl+k ctrl+u",
        "mac": "cmd+k cmd+u",
        "when": "editorTextFocus && !editorReadonly && editorLangId =~ /^gams(-inc)?$/"
      },
      {
        "command": "gams.toggleBlockComment",
        "key": "shift+alt+a",
        "when": "editorTextFocus && !editorReadonly && editorLangId =~ /^gams(-inc)?$/"
      },
      {
        "command": "gams.insertNewSection",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "editorTextFocus && !editorReadonly && editorLangId =~ /^gams(-inc)?$/"
      },
      {
        "command": "gams.jumpToMatchingParenthesis",
        "key": "ctrl+b",
        "mac": "cmd+b",
        "when": "editorTextFocus && editorLangId =~ /^gams(-inc)?$/ && config.gams.editor.studioParentheses"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "gams.gdxFiles.open",
          "when": "view == gams.gdxFiles && viewItem == gdxFile",
          "group": "navigation@1"
        },
        {
          "command": "gams.gdxFiles.compare",
          "when": "view == gams.gdxFiles && viewItem == gdxFile && gams.gdxCompareAvailable",
          "group": "navigation@2"
        }
      ],
      "explorer/context": [
        {
          "command": "gams.setMainFile",
          "when": "resourceExtname == .gms",
          "group": "gams@0"
        },
        {
          "command": "gams.gdxDiff",
          "when": "resourceExtname == .gdx",
          "group": "gams@1"
        },
        {
          "command": "gams.gdxCompare",
          "when": "resourceExtname == .gdx",
          "group": "gams@2"
        },
        {
          "command": "gams.openInStudio",
          "when": "resourceExtname =~ /\\.(gms|gdx|lst)$/i && (config.gams.studio.allowRemote || !remoteName)",
          "group": "gams@3"
        }
      ],
      "editor/title/run": [
        {
          "command": "gams.runConnect",
          "when": "gams.connectFile",
          "group": "navigation@1"
        },
        {
          "command": "gams.run",
          "when": "resourceLangId =~ /^gams(-inc)?$/",
          "group": "navigation@1"
        },
        {
          "command": "gams.compile",
          "when": "resourceLangId =~ /^gams(-inc)?$/",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "gams.treatAsConnect",
          "when": "resourceLangId == yaml && !gams.connectFile",
          "group": "gams@1"
        },
        {
          "command": "gams.contextHelp",
          "when": "editorLangId =~ /^gams(-inc|-opt|-lst)?$/",
          "group": "gams@9"
        },
        {
          "command": "gams.toggleLineComment",
          "when": "editorLangId =~ /^gams(-inc)?$/ && !editorReadonly",
          "group": "gams@5"
        },
        {
          "command": "gams.toggleBlockComment",
          "when": "editorLangId =~ /^gams(-inc)?$/ && !editorReadonly",
          "group": "gams@6"
        }
      ],
      "commandPalette": [
        {
          "command": "gams.gdxFiles.open",
          "when": "false"
        },
        {
          "command": "gams.gdxFiles.compare",
          "when": "false"
        },
        {
          "command": "gams.openGdxSymbol",
          "when": "false"
        },
        {
          "command": "gams.runConnect",
          "when": "gams.connectFile"
        },
        {
          "command": "gams.treatAsConnect",
          "when": "resourceLangId == yaml"
        },
        {
          "command": "gams.run",
          "when": "editorLangId =~ /^gams(-inc)?$/"
        },
        {
          "command": "gams.compile",
          "when": "editorLangId =~ /^gams(-inc)?$/"
        },
        {
          "command": "gams.runWithOptions",
          "when": "editorLangId =~ /^gams(-inc)?$/"
        },
        {
          "command": "gams.compileWithOptions",
          "when": "editorLangId =~ /^gams(-inc)?$/"
        },
        {
          "command": "gams.interrupt",
          "when": "gams.running"
        },
        {
          "command": "gams.stop",
          "when": "gams.running"
        },
        {
          "command": "gams.debug",
          "when": "editorLangId =~ /^gams(-inc)?$/"
        },
        {
          "command": "gams.stepDebug",
          "when": "editorLangId =~ /^gams(-inc)?$/"
        },
        {
          "command": "gams.profile",
          "when": "editorLangId =~ /^gams(-inc)?$/"
        },
        {
          "command": "gams.debug.openSnapshot",
          "when": "debugType == gams"
        },
        {
          "command": "gams.toggleLineComment",
          "when": "editorLangId =~ /^gams(-inc)?$/"
        },
        {
          "command": "gams.toggleBlockComment",
          "when": "editorLangId =~ /^gams(-inc)?$/"
        },
        {
          "command": "gams.insertNewSection",
          "when": "editorLangId =~ /^gams(-inc)?$/"
        },
        {
          "command": "gams.openInStudio",
          "when": "config.gams.studio.allowRemote || !remoteName"
        },
        {
          "command": "gams.addLineComment",
          "when": "editorLangId =~ /^gams(-inc)?$/"
        },
        {
          "command": "gams.removeLineComment",
          "when": "editorLangId =~ /^gams(-inc)?$/"
        }
      ],
      "view/title": [
        {
          "command": "gams.gdxSearch.symbol",
          "when": "view == gams.gdxFiles",
          "group": "navigation@1"
        },
        {
          "command": "gams.gdxSearch.element",
          "when": "view == gams.gdxFiles",
          "group": "navigation@2"
        },
        {
          "command": "gams.gdxFiles.refresh",
          "when": "view == gams.gdxFiles",
          "group": "navigation@3"
        },
        {
          "command": "gams.symbols.filter",
          "when": "view == gams.symbols",
          "group": "navigation@1"
        },
        {
          "command": "gams.symbols.clearFilter",
          "when": "view == gams.symbols",
          "group": "navigation@2"
        },
        {
          "command": "gams.symbols.refresh",
          "when": "view == gams.symbols",
          "group": "navigation@3"
        }
      ],
      "debug/toolBar": [
        {
          "command": "gams.debug.openSnapshot",
          "when": "debugType == gams",
          "group": "navigation@9"
        }
      ],
      "editor/title": [
        {
          "command": "gams.openInStudio",
          "when": "resourceExtname =~ /\\.(gms|gdx|lst)$/i && (config.gams.studio.allowRemote || !remoteName)",
          "group": "navigation@9"
        }
      ]
    },
    "configuration": [
      {
        "title": "GAMS",
        "properties": {
          "gams.gdxSearch.exclude": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "markdownDescription": "Extra glob patterns excluded from workspace GDX search and the GDX Files view (in addition to `files.exclude` and `search.exclude`), e.g. `**/scratch/**`."
          },
          "gams.gdxSearch.maxFiles": {
            "type": "number",
            "default": 5000,
            "minimum": 1,
            "description": "Maximum number of .gdx files considered by workspace GDX search."
          },
          "gams.gdxSearch.sort": {
            "type": "string",
            "enum": [
              "name",
              "file",
              "mtime"
            ],
            "default": "name",
            "description": "Initial sort order of \"Find Symbol in GDX Files\" (name, file or modification time)."
          },
          "gams.userModelLibraryDir": {
            "type": "string",
            "default": "",
            "description": "Folder searched recursively for user model libraries (*.glb). Default: ~/Documents/GAMS/modellibs."
          },
          "gams.modelLibraryTargetDir": {
            "type": "string",
            "default": "",
            "description": "Default target folder when copying a library model (default: first workspace folder)."
          },
          "gams.sysdir": {
            "type": "string",
            "default": "",
            "markdownDescription": "GAMS system directory (the folder that contains `gams`/`gams.exe`; a path to the executable itself is accepted). If empty it is auto-detected: `gams` on PATH, then the newest `/opt/gams/*`, `C:/GAMS/*` / `C:/GAMS/win64/*` or `/Library/Frameworks/GAMS.framework/Versions/*/Resources` (macOS). With several versions the newest is used; run **GAMS: Select GAMS Installation** (or click the version in the status bar) to choose another. In a remote window (SSH, WSL) set it under the Remote tab."
          },
          "gams.defaultParameters": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "markdownDescription": "Additional GAMS command line parameters appended to every run, e.g. `lo=3`, `--myflag=1`. An entry may hold several parameters (`lo=3 reslim=10`). Studio's own defaults (`logoption=3 ide=1 errorlog=99 errmsg=1 pagesize=0 lstTitleleftaligned=1`) are always passed first."
          },
          "gams.serverPath": {
            "type": "string",
            "default": "",
            "markdownDescription": "Path to the language server binary. Empty uses the bundled `server/bin/gams-lsp`, falling back to `server/target/debug/gams-lsp`."
          },
          "gams.log.maxLines": {
            "type": "number",
            "default": 50000,
            "minimum": 0,
            "markdownDescription": "Maximum number of lines kept in the GAMS Log document. When a run writes more, the oldest lines are dropped from the document and the complete log is written to `<filestem>.log` in the working directory (the first line of the document says so). `0`: no limit."
          },
          "gams.showLogOnRun": {
            "type": "boolean",
            "default": true,
            "description": "Open the clickable GAMS log document when a run starts."
          },
          "gams.openListingAfterRun": {
            "type": "boolean",
            "default": false,
            "description": "Open the listing file (.lst) after a run finished. Off by default (GAMS Studio opens the listing only on request)."
          },
          "gams.editor.openLocation": {
            "type": "string",
            "default": "beside",
            "enum": [
              "beside",
              "active",
              "1",
              "2",
              "3",
              "4",
              "5",
              "6",
              "7",
              "8",
              "9"
            ],
            "markdownDescription": "Editor group where the listing file and the GAMS log open: `beside`, `active` or a group number `1`..`9`. If unset, the deprecated `GAMS.listingFileLocation` is used."
          },
          "gams.editor.preserveFocus": {
            "type": "boolean",
            "default": true,
            "description": "Keep the focus in the current editor when the listing file or the GAMS log opens. If unset, the deprecated `GAMS.preserveFocus` is used."
          },
          "gams.studioColors": {
            "type": "string",
            "default": "off",
            "enum": [
              "off",
              "auto",
              "light",
              "dark",
              "distinct-light",
              "dracula-dark",
              "solarized-light",
              "solarized-dark"
            ],
            "enumDescriptions": [
              "Use the colors of the active VS Code color theme.",
              "Studio's default theme matching the VS Code color theme: Studio \"Light\" for light themes, Studio \"Dark\" otherwise.",
              "GAMS Studio theme \"Light\".",
              "GAMS Studio theme \"Dark\".",
              "GAMS Studio theme \"Distinct - light\".",
              "GAMS Studio theme \"Dracula - dark\".",
              "GAMS Studio theme \"Solarized - light\".",
              "GAMS Studio theme \"Solarized - dark\"."
            ],
            "markdownDescription": "Use the GAMS Studio syntax colors (and bold/italic styles) for GAMS files. **Note:** when enabled this writes rules for the `gams*` semantic token types and `*.gams` TextMate scopes into your user `editor.semanticTokenColorCustomizations` and `editor.tokenColorCustomizations` settings; choosing `off` removes only those entries again. `auto` follows the light/dark kind of the active VS Code color theme."
          },
          "gams.updateReferencesOnSave": {
            "type": "boolean",
            "default": false,
            "markdownDescription": "Re-create the reference file (`action=c`, a compile-only GAMS run) every time a `.gms` file of the loaded model is saved, so that the Symbols view and the language features stay current. **Each save starts a GAMS compile, which uses a GAMS license session.** Off by default."
          },
          "gams.neos.email": {
            "type": "string",
            "scope": "application",
            "default": "",
            "markdownDescription": "Email address sent to the [NEOS Server](https://neos-server.org) with every `GAMS: Run on NEOS` submission (required by NEOS). It is never filled in automatically."
          },
          "gams.neos.priority": {
            "type": "string",
            "enum": [
              "short",
              "long"
            ],
            "default": "short",
            "markdownDescription": "NEOS priority. `short`: limited to 5 minutes, the log is streamed while the job runs. `long`: no time limit, the job number and password are shown in the log and the log arrives with the final results."
          },
          "gams.neos.server": {
            "type": "string",
            "scope": "application",
            "default": "https://neos-server.org:3333",
            "markdownDescription": "URL of the NEOS XML-RPC server (GAMS Studio default). Must be `https`; `http` is accepted for localhost only."
          },
          "gams.neos.forceGdx": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Ask NEOS to return a GDX file (`gdx=default`), as the GAMS Studio NEOS dialog option \"Create a GDX file\"."
          },
          "gams.connect.arguments": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "markdownDescription": "`key=value` arguments passed to `gamsconnect` after the YAML file. Each `%key%` in the Connect file is replaced by `value` (case-insensitive) before the file is parsed."
          },
          "gams.gdxDiff.coloredView": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "After `GAMS: GDX Diff...` run gdxdiff, open the result in the colored side-by-side diff view (extension feature). Turn off to open the plain GDX viewer like GAMS Studio."
          },
          "gams.stopGracePeriod": {
            "type": "number",
            "default": 10,
            "minimum": 0,
            "markdownDescription": "Seconds `GAMS: Stop` waits after sending the GAMS interrupt before killing the job. A job that ends normally frees its network-license session immediately; a killed job keeps it reserved for about 5 minutes. Pressing Stop again kills at once. `0` = immediate kill (GAMS Studio behaviour)."
          },
          "gams.help.source": {
            "type": "string",
            "enum": [
              "offline",
              "online"
            ],
            "default": "offline",
            "enumDescriptions": [
              "Show the documentation installed with GAMS (<sysdir>/docs, version-matched) in a GAMS Help panel; falls back to the online documentation if it is missing.",
              "Open https://www.gams.com/<major>/docs/... in the external browser."
            ],
            "markdownDescription": "Where `GAMS: Help for Word at Cursor` (F1) shows the documentation."
          },
          "gams.help.f1": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Bind `F1` in GAMS editors to `GAMS: Help for Word at Cursor` (context help like GAMS Studio). When off, `F1` keeps opening the Command Palette there; the Command Palette is always available on `Ctrl+Shift+P`."
          },
          "gams.studio.path": {
            "type": "string",
            "default": "",
            "markdownDescription": "Path to the GAMS Studio executable used by **Open in GAMS Studio**. If empty it is detected: `<sysdir>/studio/studio.AppImage` (Linux), `<sysdir>/studio/studio.exe` (Windows) or `/Applications/GAMS Studio.app` (macOS)."
          },
          "gams.studio.arguments": {
            "type": "string",
            "default": "",
            "markdownDescription": "Additional command line arguments for GAMS Studio, e.g. `-platform xcb`."
          },
          "gams.studio.allowRemote": {
            "type": "boolean",
            "default": false,
            "markdownDescription": "Allow **Open in GAMS Studio** in remote windows (SSH, WSL, containers). Studio then starts on the remote machine and needs a display there."
          },
          "gams.editor.studioParentheses": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Replaces VS Code's bracket colorization/matching in GAMS files with GAMS Studio's behavior: the parenthesis pair next to the cursor is highlighted (red for mismatched or unmatched ones), and Ctrl+B in GAMS editors jumps to the matching parenthesis instead of toggling the sidebar. Set to `false` to restore VS Code behavior (re-enable `editor.matchBrackets` for `[gams]` yourself)."
          },
          "gams.editor.bracketNestingColors": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Color nested brackets `( ) [ ] { }` in GAMS files by nesting level, using the colors of VS Code's bracket pair colorization (`editorBracketHighlight.*` theme colors) but the bracket structure of GAMS Studio's syntax highlighter: brackets in comments (also end-of-line comments with a custom `$eolCom`), quoted strings, unquoted symbol descriptions and `$onText` blocks are not colored. VS Code's own colorizer is turned off for `[gams]` (it cannot skip descriptions and custom end-of-line comments); set this to `false` to have no nesting colors in GAMS files."
          }
        }
      },
      {
        "title": "GAMS (0.1.x, deprecated)",
        "properties": {
          "GAMS.terminalCwd": {
            "type": "string",
            "deprecationMessage": "Setting of GAMS 0.1.x, still supported but deprecated: use projects, the gams.editor.* settings or GAMS tasks instead.",
            "markdownDescription": "Deprecated, still supported: working directory of the run batch file (`GAMS.runProject`) and of normal runs (unless a .gsp project sets one). Prefer a project (`.gsp`) work directory or a task `options.cwd`."
          },
          "GAMS.executablePath": {
