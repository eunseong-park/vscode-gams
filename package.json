      "activitybar": [
        {
          "id": "gams",
          "title": "GAMS",
          "icon": "$(symbol-namespace)"
        }
      ]
    },
    "views": {
      "gams": [
        {
          "id": "gams.symbols",
          "name": "Symbols",
          "contextualTitle": "GAMS Symbols"
        },
        {
          "id": "gams.projects",
          "name": "Projects",
          "contextualTitle": "GAMS Projects"
        },
        {
          "id": "gams.gdxFiles",
          "name": "GDX Files",
          "contextualTitle": "GAMS GDX Files"
        }
      ]
