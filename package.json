            "markdownDescription": "Deprecated, still supported: fallback for `gams.editor.preserveFocus`."
          },
          "GAMS.runProject": {
            "type": "boolean",
            "deprecationMessage": "Setting of GAMS 0.1.x, still supported but deprecated: use projects, the gams.editor.* settings or GAMS tasks instead.",
            "markdownDescription": "Deprecated, still supported: with `GAMS.runBatchPath` set, **Run** (F9) executes that batch file in a terminal instead of GAMS. Prefer a GAMS task chained with a shell task (`dependsOn`) in tasks.json."
          },
          "GAMS.runBatchPath": {
