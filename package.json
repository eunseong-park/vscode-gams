    "@vscode/vsce": "^4.1.0",
    "ajv": "^8.20.0",
    "esbuild": "^0.24.0",
    "js-yaml": "^4.3.2",
    "mocha": "^10.8.2",
    "typescript": "^5.6.3"
  },
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
